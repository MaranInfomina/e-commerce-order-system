<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <!-- CACHE_STORE is deliberately NOT forced here. Forcing it makes
             config('cache.default') a constant for the whole suite, so
             RedisGuardTest would assert phpunit's own hardcoded string
             rather than what the container is actually configured to do.
             Letting the container value flow through is the only
             arrangement in which the guard can fail when the driver is
             wrong, and failing then is the entire point of it. -->
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <!-- DB_DATABASE is intentionally not forced here: tests/bootstrap.php
             (which PHPUnit runs after this <php> block) resolves it from the
             container's DB_TEST_DATABASE variable instead, so the test
             database name has a single source of truth. -->
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- REDIS_URL is forced empty on purpose. Every redis connection in
             config/database.php reads it, and Laravel's ConfigurationUrlParser
             lets a URL PATH override the database index, so a single
             REDIS_URL=redis://redis:6379/0 in a root .env silently collapses
             the test cache back onto development database 0 with every guard
             still green. Empty here means the explicit host/port/database
             settings below are the only source. -->
        <env name="REDIS_URL" value="" force="true"/>
        <env name="REDIS_DB" value="15" force="true"/>
        <env name="REDIS_CACHE_DB" value="14" force="true"/>
        <env name="CACHE_PREFIX" value="" force="true"/>
        <!-- These three need a <server> mirror, not just <env>: phpdotenv
             reads $_SERVER before $_ENV and getenv(), PHPUnit's <env>
             only calls putenv(), and Compose already places every
             variable it injects into $_SERVER. Without the mirror the
             <env> value is silently ignored and the test cache lands on
             development database 0. -->
        <server name="REDIS_URL" value="" force="true"/>
        <server name="REDIS_DB" value="15" force="true"/>
        <server name="REDIS_CACHE_DB" value="14" force="true"/>
        <server name="CACHE_PREFIX" value="" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_CONNECTION" value="pgsql" force="true"/>
        <!-- DB_DATABASE is intentionally not forced here either — see the
             matching comment in the <env> block above. -->
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
    </php>
</phpunit>
