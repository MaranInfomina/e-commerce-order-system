# ---------------------------------------------------------------
# Copy to .env (scripts/setup does this for you). Never commit .env.
# ---------------------------------------------------------------

# Application
APP_NAME="COE Order System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Host port for the nginx edge — the only published port
APP_PORT=8080

# PostgreSQL container
POSTGRES_DB=coe_orders
POSTGRES_USER=coe
POSTGRES_PASSWORD=local_dev_only
POSTGRES_TEST_DB=coe_orders_test

# Laravel database connection (host is the compose service name)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=coe_orders
DB_USERNAME=coe
DB_PASSWORD=local_dev_only

# Laravel runtime
LOG_CHANNEL=stderr
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
