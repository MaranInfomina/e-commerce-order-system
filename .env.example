# ---------------------------------------------------------------
# Copy to .env (scripts/setup does this for you). Never commit .env.
# ---------------------------------------------------------------

# Application
APP_NAME="COE Order System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Host port for the nginx edge — the only published port
APP_PORT=8080

# Host port for the nginx edge's HTTPS listener (self-signed cert,
# generated by setup.sh/setup.ps1). Plain HTTP on APP_PORT redirects here.
APP_HTTPS_PORT=8443

# PostgreSQL container
POSTGRES_DB=coe_orders
POSTGRES_USER=coe
POSTGRES_PASSWORD=local_dev_only
POSTGRES_TEST_DB=coe_orders_test

# Laravel database connection (host is the compose service name)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=coe_orders
DB_USERNAME=coe
DB_PASSWORD=local_dev_only

# Redis container. Six logical databases: three the running app uses, and
# three the test suite mirrors them onto, so no separate concern can flush
# another's keys and the suite can never touch the developer's live data.
#
#   0 = cache                (safe to flush)              14 under test
#   1 = carts + JWT denylist (never flushed wholesale)    15 under test
#   2 = sessions             (flushing = a mass logout)   13 under test
#
# src/backend/phpunit.xml forces 13/14/15 and src/backend/tests/Pest.php
# flushes all three between every test. REDIS_TEST_DB names the carts +
# denylist test index for config/database.php's `test` connection; it is
# declared here and in docker-compose.yml rather than living only as a
# hardcoded default in that file.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_DB=1
REDIS_SESSION_DB=2
REDIS_TEST_DB=15

# JWT signing. Leave JWT_SECRET empty for a clean clone: the entrypoint
# generates an ephemeral key and warns. ./setup.sh writes a stable one.
# TTL is in seconds.
JWT_SECRET=
JWT_TTL=3600

# Object storage (Garage, S3-compatible). The entrypoint creates the bucket
# and an access key on first boot and prints them; ./setup.sh writes them
# into this file. Path-style addressing is required - virtual-host style
# needs DNS wildcards a compose network does not have.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage
AWS_BUCKET=coe-products
AWS_ENDPOINT=http://garage:3900
AWS_USE_PATH_STYLE_ENDPOINT=true

# RabbitMQ (Milestone 3 async order flow). Default guest/guest credentials
# are the broker image's own built-in account, scoped to the compose-internal
# network only (no port published except the management UI, bound to
# localhost) — sufficient for a single-tenant local stack, so unlike
# GARAGE_RPC_SECRET/JWT_SECRET no script generates a replacement.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=orders

# Mailpit (Milestone 3 order-confirmation email). Dev-only mail catcher, no
# production equivalent — the production overlay must point MAIL_MAILER at a
# real transport instead; this project does not define what that transport is
# (out of scope for this milestone).
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=orders@coe.local
MAIL_FROM_NAME="COE Order System"

# Where the browser fetches product images from. This must be an address a
# CLIENT can reach, not the compose-internal one above: leave it unset and
# Flysystem falls back to {AWS_ENDPOINT}/{bucket}/{key}, publishing the
# internal hostname http://garage:3900/... in every product response.
AWS_URL=http://localhost:8080/storage

# Garage cluster RPC credential. ./setup.sh generates one on first run.
# docker-compose.yml carries a published throwaway default so a clean clone
# boots; docker-compose.prod.yml refuses to start without a real value.
GARAGE_RPC_SECRET=

# Empty on purpose. Laravel's cache store would otherwise prepend
# "<app_name>_cache_" on top of the coe_ client prefix, so a key written as
# product:1 would land in Redis as coe_laravel_cache_product:1 and every
# redis-cli command in the README and this plan would find nothing.
CACHE_PREFIX=

# Laravel runtime
LOG_CHANNEL=stderr
CACHE_STORE=redis
SESSION_DRIVER=redis
# Sessions get their own Redis connection (REDIS_SESSION_DB above). Left
# unset, Laravel's redis session driver writes to the `default` connection —
# logical database 1, the carts + JWT denylist database that is documented as
# never flushed wholesale. config/session.php defaults this to `session` too,
# so the split survives even without this file.
SESSION_CONNECTION=session
# rabbitmq outside tests; src/backend/phpunit.xml forces this to `sync` for
# the whole suite so most tests run jobs synchronously in-process. The one
# test that needs the real broker (tests/Feature/QueueConnectivityTest.php)
# overrides config('queue.default') at runtime instead of relying on this.
QUEUE_CONNECTION=rabbitmq

# Entrypoint behaviour on container start. AUTO_MIGRATE runs
# `php artisan migrate --force`; AUTO_SEED runs the guarded
# `php artisan app:seed-if-empty`. Set to "false" to skip either — this is
# already done for you in docker-compose.prod.yml.
AUTO_MIGRATE=true
AUTO_SEED=true

# Regenerates storage/api-docs/api-docs.json (the OpenAPI spec behind /docs
# and /api-docs) on every request, so it always reflects the current OA
# attributes with no manual `artisan l5-swagger:generate` step. This is
# already turned off in docker-compose.prod.yml, where the spec only changes
# on a deploy.
L5_SWAGGER_GENERATE_ALWAYS=true

# Vault (Milestone 4, optional). Leave VAULT_ADDR empty to skip Vault
# entirely — setup.sh/setup.ps1 fall back to generating secrets directly
# into .env, exactly as every milestone before this one already does.
VAULT_ADDR=
VAULT_DEV_ROOT_TOKEN_ID=coe-dev-root-token
