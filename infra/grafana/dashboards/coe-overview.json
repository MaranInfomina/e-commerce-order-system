{
  "title": "COE Order System Overview",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Request Rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(coe_http_requests_total[1m])) by (route)", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Duration (p95)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(coe_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Queue Job Throughput",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(coe_queue_jobs_processed_total[1m])) by (job)", "legendFormat": "{{job}} processed" },
        { "expr": "sum(rate(coe_queue_jobs_failed_total[1m])) by (job)", "legendFormat": "{{job}} failed" }
      ]
    }
  ]
}
