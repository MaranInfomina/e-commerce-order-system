upstream php_upstream {
    server php-fpm:9000;
}

server {
    listen 80;
    server_name _;

    # Plain HTTP always redirects to HTTPS. The port is templated from
    # APP_HTTPS_PORT (set as an env var on this container in
    # docker-compose.yml) via the official nginx image's envsubst-on-templates
    # entrypoint: this file lives at /etc/nginx/templates/default.conf.template
    # and is rendered to /etc/nginx/conf.d/default.conf on container start.
    # That rendering only substitutes variables that are actually set in the
    # container's environment, so nginx's own $host/$request_uri below are
    # left untouched.
    return 301 https://$host:${APP_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    server_name _;

    # Self-signed, training-grade certificate generated by
    # scripts/setup.sh/setup.ps1 (see infra/nginx/certs/, gitignored).
    ssl_certificate     /etc/nginx/certs/localhost.crt;
    ssl_certificate_key /etc/nginx/certs/localhost.key;

    client_max_body_size 20m;

    root /var/www/html/public;
    index index.php;

    # API: everything under /api is handled by Laravel's front controller.
    # Anchored regex so this matches only /api itself or /api/..., not a
    # prefix like /apidocs or /api-guide, which must fall through to the
    # location / proxy below and reach Nuxt instead.
    location ~ ^/api(/|$) {
        try_files $uri /index.php?$query_string;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_pass php_upstream;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_read_timeout 60s;
    }

    # Product images. Storage::disk('s3')->url() publishes
    # {AWS_URL}/{key}; Flysystem omits the bucket, so the bucket is selected
    # here by Host against Garage's web endpoint. The trailing slash on
    # proxy_pass strips the /storage/ prefix, leaving the bare object key.
    # Read-only by design: writes go through the authenticated API.
    location /storage/ {
        proxy_pass http://garage:3902/;
        proxy_http_version 1.1;
        proxy_set_header Host coe-products.web.garage;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        add_header X-Content-Type-Options nosniff always;

        limit_except GET HEAD { deny all; }
    }

    # Frontend: everything else is proxied to the Nuxt SSR server.
    location / {
        proxy_pass http://nuxt:3000;
        proxy_http_version 1.1;

        # Required for the Vite HMR websocket.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 60s;
    }
}
